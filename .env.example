# Copy to .env and fill in. .env is gitignored -- never commit the real key.
#
# Deliberately NOT exported from ~/.bashrc: Claude Code reads
# ANTHROPIC_API_KEY too, and a global export can move Claude Code itself
# onto API billing instead of your subscription. Keeping the key here
# means evaluation runs can spend money and the editor cannot.
# Loaded by codenames/env.py at the point an API client is constructed.

ANTHROPIC_API_KEY=sk-ant-...

# Only needed for identity-linked (org/SSO) keys, which are rejected with
# a 400 unless every request names a workspace. Leave unset for a plain
# personal key -- see codenames/guessers/llm.py::LLMGuesser.client.
# ANTHROPIC_WORKSPACE_ID=

# Optional: an OpenAI-compatible host for cheap bulk evaluation
# (codenames/guessers/openai_compat.py). Same rule as above -- keep it here,
# not in the shell profile. Only the provider you actually use needs a key.
#
# DeepInfra serves open-weight models at ~47x less per call than Sonnet on
# this workload (measured, not from token prices -- see docs/log.md), which is
# what makes a fine-grained sigma sweep affordable at all.
DEEPINFRA_API_KEY=
# GROQ_API_KEY=
# TOGETHER_API_KEY=
# OPENAI_API_KEY=

