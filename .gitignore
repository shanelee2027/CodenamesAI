data/*
!data/.gitkeep
cache/*
!cache/.gitkeep
__pycache__/
.venv/
*.npy
*.bin
*.db
*.pyc
.pytest_cache/
*.egg-info/
.ipynb_checkpoints/
.env
!.env.example

# LaTeX build artifacts (docs/clue-selection-theory.tex). The PDF itself is
# tracked -- it is the form the document gets read and sent in, and it has to
# be reachable from a machine with no TeX toolchain. Rebuild it after editing
# the .tex, or the committed copy silently goes stale.
docs/*.aux
docs/*.log
docs/*.synctex.gz
docs/*.out
