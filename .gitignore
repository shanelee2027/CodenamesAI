data/*
!data/.gitkeep
cache/*
!cache/.gitkeep
# 5 KB, built from our own game records (scripts/data/build_win_value.py
# --max-game-id 15907 --margin 0.5). Tracked so a clone that already has the
# demo bundle's cache can play the margin-V menu entries after a pull.
!cache/win_value_margin.npz
__pycache__/
.venv/
.venv-vllm/
*.npy
*.bin
*.db
*.pyc
.pytest_cache/
*.egg-info/
.ipynb_checkpoints/
.env
!.env.example

# LaTeX build artifacts (docs/clue-selection-theory.tex). The PDF itself is
# tracked -- it is the form the document gets read and sent in, and it has to
# be reachable from a machine with no TeX toolchain. Rebuild it after editing
# the .tex, or the committed copy silently goes stale.
docs/*.aux
docs/*.log
docs/*.synctex.gz
docs/*.out

# The demo bundle's own files (scripts/tools/make_demo_bundle.py), for when it
# is unpacked into a clone: everything else in it is on the repo's own paths.
/DEMO.md
/requirements-demo.txt
/start.sh
/start.bat
